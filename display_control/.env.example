# --- Display mode -------------------------------------------------------
# christmas, power, departures, sky, picture, weather, fire or colors (set from the web UI)
DISPLAY_MODE=sky

# --- LED matrix ---------------------------------------------------------
# Panel size: 64x32 (two chained 32x32 panels) or 32x32 (one panel)
LED_PANEL=64x32
# Advanced overrides of the preset (leave empty): LED_ROWS, LED_COLS, LED_CHAIN,
# LED_PARALLEL, LED_Y_OFFSET (first visible row; 32 when wired to the HAT's 2nd output)
# GPIO slowdown. Empty = auto by Pi model (Pi 4/5: 4, Pi 3: 2).
# Raise it if the image glitches or flickers, lower it for a higher refresh rate.
LED_GPIO_SLOWDOWN=
# Panel brightness in percent. Lower it if the Pi reports undervoltage (flickering)
LED_BRIGHTNESS=80

# --- Sky Clock and Weather ----------------------------------------------
# Location for sun, moon and weather (decimal degrees; set on the System page). Default: Darmstadt
SKY_LAT=49.87
SKY_LON=8.65
# Show the current weather (clouds, rain, snow) from open-meteo.com. 0 = off
SKY_WEATHER=1

# --- Fireplace / Ambient Colors -----------------------------------------
# Fire burns down to embers from this time (HH:MM) until 6:00. Empty = always burning
FIRE_BEDTIME=
# Fireplace quality: auto (light on a Pi 3 or older), smooth (15 fps) or light (10 fps, less CPU)
FIRE_QUALITY=auto
# Ambient Colors: minutes per palette, which palettes (empty = all built-in, see
# color_palettes.py; "custom" = your own), and your own colours (#rrggbb, 2-6 of them)
COLORS_MINUTES=3
COLORS_PALETTES=
COLORS_CUSTOM=

# --- Pictures (managed on the web UI's Pictures page) --------------------
# Seconds per picture, and how the next one comes in: slide, fade or cut
PICTURE_SECONDS=20
PICTURE_TRANSITION=slide

# --- Home Assistant (Power Flow mode) -----------------------------------
# e.g. http://homeassistant.local:8123
HA_URL=
# Profile -> Security -> Long-lived access tokens
HA_TOKEN=
# Solar production in W, and grid power in W (negative = feeding in)
HA_SOLAR_ENTITY=sensor.balkonkraftwerk_power
HA_GRID_ENTITY=sensor.main_power

# --- RMV (Departures mode) ----------------------------------------------
# Free key from https://opendata.rmv.de (register, then request API access)
RMV_ACCESS_TOKEN=
# Stop to show departures from (3004736 = Darmstadt Luisenplatz)
RMV_STATION_ID=3004736
# Only show departures heading via these stops, as id:label,id:label. Empty = all.
RMV_DIRECTIONS=3024730:Hbf,3004734:LiWi
# Only these lines, comma-separated (e.g. 4,5,671). Empty = all.
RMV_LINES=
# Shown in the web UI only
RMV_STATION_NAME=Darmstadt-Luisenplatz
# Hide departures you can't reach in time
RMV_WALK_MINUTES=2
# How often to ask RMV (90 s = ~1000 requests/day per direction)
RMV_POLL_SECONDS=90

# --- Wi-Fi fallback -----------------------------------------------------
# After this many minutes without Wi-Fi/Ethernet, open the setup hotspot
WIFI_FALLBACK_MINUTES=3
# While the hotspot is idle (no phone connected), retry known networks this often
WIFI_RETRY_MINUTES=10
# Hotspot name. Empty = <hostname>-setup, e.g. pidisplay-setup
WIFI_SETUP_SSID=
# 8+ characters; install.sh generates one if empty
WIFI_SETUP_PASSWORD=

# --- Software updates (web UI's System page) ----------------------------
# Releases are fetched from this (public) GitHub repository
GITHUB_REPO=nicolasj92/TrainTime
