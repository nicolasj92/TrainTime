[Unit]
Description=TrainTime web control (mode switcher on port 5000)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/workspace/TrainTime/display_control
ExecStart=/usr/bin/python3 web_control.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
