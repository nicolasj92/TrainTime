[Unit]
Description=LED Display Web Control Interface
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/workspace/TrainTime/display_control
Environment=FLASK_APP=web_control.py
ExecStart=/usr/bin/python3 web_control.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
